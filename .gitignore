# Rust
/target
**/target/
**/*.rs.bk

# Node / frontend
node_modules/
dist/
.pnpm-store/
*.tsbuildinfo

# Tauri
app/desktop/gen/
# Built by tools/sidecars.mjs before the app
app/desktop/binaries/

# Path of Building for the engine tests (tools/fetch-pob.sh)
/.pob/

# Data-extractor toolchain (only the generated crates/data/data/ is committed)
tools/data-extractor/node_modules/
tools/data-extractor/.cache/
tools/data-extractor/tables/
tools/data-extractor/raw/

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Local secrets
.env
.env.*
*.local.*
*.local
# ts-rs default export dir (canonical bindings live in app/ui/src/ipc/generated via TS_RS_EXPORT_DIR)
crates/core/bindings/

# Personal agent settings and the skill's downloaded binary
.claude/settings.local.json
.claude/worktrees/
.claude/skills/impeccable/scripts/bin/

# impeccable working files. design.json and surfaces/ are shared.
.impeccable/config.local.json
.impeccable/hook.*.json
.impeccable/review/
.impeccable/questions/
.impeccable/mocks/
.impeccable/build/
.impeccable/history/
.impeccable/live/
.impeccable/provider-smoke/

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exile Companion",
  "version": "0.1.0",
  "identifier": "com.exilecompanion.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../.." }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "create": false,
        "title": "Exile Companion",
        "url": "index.html",
        "width": 420,
        "height": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "menu",
        "create": false,
        "focus": false,
        "title": "Exile Companion menu",
        "url": "index.html",
        "width": 236,
        "height": 336,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "settings",
        "create": false,
        "focus": false,
        "title": "Exile Companion settings",
        "url": "index.html",
        "width": 520,
        "height": 640,
        "minWidth": 440,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

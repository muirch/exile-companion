{
  "name": "exile-companion-data-extractor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Builds Exile Companion's campaign data from the Path of Exile game files.",
  "scripts": {
    "fetch": "pathofexile-dat",
    "regen": "tsx src/export.ts",
    "routes": "tsx src/routes.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pathofexile-dat": "15.2.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
